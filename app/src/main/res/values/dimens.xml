<?xml version="1.0" encoding="utf-8"?>
<!-- Design tokens (#37): a single source of truth for radii, spacing and type
     scale across the app screens, so the home overhaul reads as one system.
     NOTE: widget_bg.xml keeps its own 22dp radius — it's shared with the real
     home-screen widgets and is deliberately NOT tokenised here. -->
<resources>

    <!-- Corner radii -->
    <dimen name="radius_sm">12dp</dimen>   <!-- fields, chips, tiles -->
    <dimen name="radius_md">16dp</dimen>   <!-- buttons -->
    <dimen name="radius_lg">20dp</dimen>   <!-- cards -->

    <!-- Spacing scale -->
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_sm">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="screen_gutter">24dp</dimen>
    <!-- One inner padding for every card on a screen (#126): the home cards used
         to sit at 18/20/22dp, so their text started on three different lines. -->
    <dimen name="card_padding">18dp</dimen>

    <!-- Type scale -->
    <dimen name="text_hero">40sp</dimen>
    <dimen name="text_headline">22sp</dimen>
    <dimen name="text_title">17sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_label">13sp</dimen>
    <dimen name="text_tile">12sp</dimen>

    <!-- Misc -->
    <dimen name="hero_glow_size">190dp</dimen>
    <dimen name="tile_icon">26dp</dimen>
    <dimen name="tile_min_height">76dp</dimen>

    <!-- ── Brand lockup, two sizes (#130) ───────────────────────────────────
         The wordmark in its glow is the header of BOTH home states, but a paired
         install has content to show underneath it, so it is presented smaller
         there: no claim line, a tighter lockup, roughly two thirds the height.
         The plain tokens are the first-run presentation, the `_compact` ones the
         paired one; `OnboardingHomeActivity.renderBrand` swaps between them. -->
    <dimen name="brand_lockup_top">32dp</dimen>
    <dimen name="brand_lockup_top_compact">4dp</dimen>
    <dimen name="brand_figure_height">39dp</dimen>
    <dimen name="brand_figure_height_compact">25dp</dimen>
    <dimen name="brand_rule_bottom">14dp</dimen>
    <dimen name="brand_rule_bottom_compact">18dp</dimen>
    <dimen name="hero_glow_size_compact">112dp</dimen>
    <dimen name="text_hero_compact">26sp</dimen>

</resources>
