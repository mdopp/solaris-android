<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon shortcut badge for any other device (#99).
     A shortcut icon is drawn by the launcher on a *light* background under a
     round adaptive mask, so the bare widget glyph (white on transparent) came
     out as a white disc. This carries its own opaque field: the brand blue behind
     the white glyph, contrasting on a light and on a dark launcher alike.
     The 30% inset keeps the glyph inside the mask's safe zone — the outer third
     of the canvas is the launcher's to crop. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/solaris_brand_blue" />
    <foreground>
        <inset android:drawable="@drawable/ic_device" android:inset="30%" />
    </foreground>
</adaptive-icon>
