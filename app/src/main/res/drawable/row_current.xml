<?xml version="1.0" encoding="utf-8"?>
<!-- The picker row that carries the widget's current binding (#96): a faint accent
     wash with an accent hairline, so a reconfigure opens on something the eye finds
     without reading a single label. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/solaris_accent_faint" />
    <corners android:radius="@dimen/radius_sm" />
    <stroke android:width="1dp" android:color="@color/solaris_accent" />
</shape>
