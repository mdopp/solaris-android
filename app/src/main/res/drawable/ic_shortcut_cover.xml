<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon shortcut badge for a cover (#99), pre-Oreo variant.
     Below API 26 there is no adaptive mask, so the tile is drawn as it stands:
     the brand-blue rounded square with the white glyph inset by half its own
     size. Blue, not the shell accent: since #130 the in-app accent follows the
     web surface to orange, but a shortcut badge is drawn in the launcher among
     foreign icons, where that argument does not reach.
     The glyph itself is @drawable/ic_cover — the same single source the
     widget uses; only the opaque background is added here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <item>
        <aapt:attr name="android:drawable">
            <shape android:shape="rectangle">
                <solid android:color="@color/solaris_brand_blue" />
                <corners android:radius="10dp" />
                <size android:width="48dp" android:height="48dp" />
            </shape>
        </aapt:attr>
    </item>
    <item
        android:drawable="@drawable/ic_cover"
        android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp" />
</layer-list>
