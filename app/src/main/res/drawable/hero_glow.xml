<?xml version="1.0" encoding="utf-8"?>
<!-- The signature "Meer des Wissens" glow (#37): a soft ServiceBay-blue radial
     halo that sits behind the wordmark figure. End colour is TRANSPARENT BLUE
     (#003B82F6), not #00000000 — that avoids a grey halo edge on the dark bg. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="110dp"
        android:startColor="#4D3B82F6"
        android:centerColor="#1F3B82F6"
        android:endColor="#003B82F6" />
</shape>
