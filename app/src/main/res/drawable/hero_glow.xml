<?xml version="1.0" encoding="utf-8"?>
<!-- The signature "Meer des Wissens" glow (#37): a soft ServiceBay-blue radial
     halo that sits behind the wordmark figure. End colour is TRANSPARENT BLUE
     (#003B82F6), not #00000000 — that avoids a grey halo edge on the dark bg.

     The radius is RELATIVE to the drawable, not a fixed dp value (#132). It used
     to be 110dp, which only ever suited the 190dp first-run circle; drawn at the
     paired 112dp the gradient had reached 56/110 ≈ 51 % at the edge — still near
     the centre colour — so the disc cut off hard. At 50 % of the shorter side the
     fade ends exactly at the circle's edge, whatever size the lockup is drawn. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="#4D3B82F6"
        android:centerColor="#1F3B82F6"
        android:endColor="#003B82F6" />
</shape>
