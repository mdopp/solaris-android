<?xml version="1.0" encoding="utf-8"?>
<!-- Folgenschwere Aktion (#92): outlined in the warning colour, faintly filled —
     visibly apart from the ordinary ghost rows without becoming a big red button
     that invites a tap. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/solaris_warn_faint" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/solaris_warn" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/solaris_warn" />
        </shape>
    </item>
</selector>
