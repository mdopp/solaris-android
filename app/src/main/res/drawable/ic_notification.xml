<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon (#88, figure #99): the Solaris figure, white on
     transparent. Android masks a small icon by its ALPHA channel and paints
     everything opaque white, so the blue tile of the launcher icon is
     deliberately left out — a filled tile renders as a solid white blob. Only
     the figure carries alpha; the brand blue comes back via
     NotificationCompat.setColor.

     Head and body are two subpaths of ONE path: the icon must stay a single
     white fill (see NotificationIconTest), and a separate head+body reads as a
     person at 24dp where a merged blob does not.

     The silhouette is traced from res/drawable-xxxhdpi/ic_solaris_figure.png
     (108x241) — the launcher figure with the blue background removed — scaled
     by 20/241 into the 24 viewport and inset 2dp on every side, because shapes
     touching the viewport edge get clipped in the status bar. Source geometry:
     head circle r=35 at y=37, neck pinch at y=72, body widest (104) at y=132,
     foot at y=238. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2A2.9,2.9 0 1,1 12,7.8A2.9,2.9 0 1,1 12,2ZM12,8.1C14.4,8.1 16.3,10.2 16.3,12.8C16.3,16.6 15.1,20.2 13.5,21.3C13,21.6 11,21.6 10.5,21.3C8.9,20.2 7.7,16.6 7.7,12.8C7.7,10.2 9.6,8.1 12,8.1Z" />
</vector>
