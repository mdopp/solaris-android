<?xml version="1.0" encoding="utf-8"?>
<!-- Pressable tile (#37) for the "Schnell hinzufügen" quick-add widget grid.
     Same design language as chip_solaris: faint accent fill + hairline edge,
     with a stronger accent tint + accent edge on press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33F97316" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke android:width="1dp" android:color="@color/solaris_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/solaris_accent_faint" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke android:width="1dp" android:color="@color/solaris_card_edge" />
        </shape>
    </item>
</selector>
