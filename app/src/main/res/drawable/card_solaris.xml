<?xml version="1.0" encoding="utf-8"?>
<!-- Tiered Solaris card: subtle vertical gradient + hairline edge, matching the
     widget_bg look so app screens and widgets read as one design language. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FF17171D"
        android:endColor="#FF0D0D11" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/solaris_card_edge" />
</shape>
