<?xml version="1.0" encoding="utf-8"?>
<!-- Devices tile (#167): small (1x1 target), resizable, no configuration.
     A tap opens the household start page, where every pinned device shows its
     live state and can be operated. No data to poll, so the update period is 0. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:description="@string/devices_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_devices"
    android:previewLayout="@layout/widget_devices"
    android:updatePeriodMillis="0" />
