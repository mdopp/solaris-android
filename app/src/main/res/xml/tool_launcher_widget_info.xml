<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 tool launcher tile (#71): one provider serves every tool AND both modes;
     the instance is bound to a tool-id + mode by ToolLauncherConfigActivity.
     Pure deep link — nothing to poll, so the update period is 0 (host default). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:description="@string/tool_launch_description"
    android:configure="cloud.dopp.solaris.widget.ToolLauncherConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_tool_launcher"
    android:previewLayout="@layout/widget_tool_launcher"
    android:updatePeriodMillis="0" />
