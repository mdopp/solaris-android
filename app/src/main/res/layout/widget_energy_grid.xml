<?xml version="1.0" encoding="utf-8"?>
<!-- Energy "Jetzt": a 2x2 flow grid (PV / Haus / Netz / Akku), each a mini-card
     with a big colored value + direction — mirroring the Solaris web Energy
     "jetzt" screen. Cells are inlined (not <include>d) so RemoteViews can address
     each child by a unique id. Reused for the flow widget (live W) and the totals
     widget (kWh). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/e_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_bolt"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/e_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Energie · jetzt"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Row 1: cell 0 | cell 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/e_cell0"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/e_l0" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="PV" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/e_v0" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FFF2F2F5"
                android:textStyle="bold" android:textSize="19sp" />
            <TextView android:id="@+id/e_d0" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="" android:textColor="#FF9AA0AE" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/e_cell1"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/e_l1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="Haus" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/e_v1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FFF2F2F5"
                android:textStyle="bold" android:textSize="19sp" />
            <TextView android:id="@+id/e_d1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="" android:textColor="#FF9AA0AE" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: cell 2 | cell 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/e_cell2"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/e_l2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="Netz" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/e_v2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FFF2F2F5"
                android:textStyle="bold" android:textSize="19sp" />
            <TextView android:id="@+id/e_d2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="" android:textColor="#FF9AA0AE" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/e_cell3"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/e_l3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="Akku" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/e_v3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FFF2F2F5"
                android:textStyle="bold" android:textSize="19sp" />
            <TextView android:id="@+id/e_d3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="" android:textColor="#FF9AA0AE" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
