<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ic_light"
        android:tint="#FFFFC107"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/w_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Wohnzimmer"
        android:textColor="#FFF2F2F5"
        android:textStyle="bold"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/w_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="an · 80 %"
        android:textColor="#FFFFC107"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="80"
        android:progressTint="#FFFFC107"
        android:progressBackgroundTint="#26FFFFFF" />
</LinearLayout>
