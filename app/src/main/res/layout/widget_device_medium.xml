<?xml version="1.0" encoding="utf-8"?>
<!-- Tall device widget (>= ~180x110 dp). Three sections spread vertically to
     fill the card height: header (icon + name) on top, state + level bar in the
     middle (given room via weight), and a full-width control row at the bottom.
     RemoteViews-safe (LinearLayout + weights only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Header (tap = on/off) -->
    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_light"
            android:tint="#FFFFC107"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Wohnzimmer"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="18sp" />

        <!-- Lock badge (#38): shown for sensitive devices needing a confirm. -->
        <ImageView
            android:id="@+id/w_lock"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_lock"
            android:tint="#FFB0BEC5"
            android:visibility="gone"
            android:contentDescription="@string/widget_lock" />

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:padding="3dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FF9AA0AE"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- Middle: prominent state + full-width level bar. Weighted so it takes the
         slack and the sections spread top-to-bottom instead of clustering. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="an · 80 %"
            android:textColor="#FFFFC107"
            android:textStyle="bold"
            android:textSize="22sp" />

        <ProgressBar
            android:id="@+id/w_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="80"
            android:progressTint="#FFFFC107"
            android:progressBackgroundTint="#26FFFFFF" />
    </LinearLayout>

    <!-- Light controls: brightness − / + across the full width -->
    <LinearLayout
        android:id="@+id/w_light_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <Button
            android:id="@+id/w_bright_down"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn_bg"
            android:text="−"
            android:textColor="#FFF2F2F5"
            android:textSize="22sp" />

        <Button
            android:id="@+id/w_bright_up"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="+"
            android:textColor="#FFF2F2F5"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Cover controls: up / stop / down across the full width -->
    <LinearLayout
        android:id="@+id/w_cover_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <Button
            android:id="@+id/w_cover_up"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn_bg"
            android:text="▲"
            android:textColor="#FF7E9CFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/w_cover_stop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn_bg"
            android:text="■"
            android:textColor="#FFF2F2F5"
            android:textSize="18sp" />

        <Button
            android:id="@+id/w_cover_down"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:text="▼"
            android:textColor="#FF7E9CFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Switch control: single full-width toggle -->
    <LinearLayout
        android:id="@+id/w_switch_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <Button
            android:id="@+id/w_switch_toggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/widget_btn_bg"
            android:text="Umschalten"
            android:textColor="#FFF2F2F5"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
