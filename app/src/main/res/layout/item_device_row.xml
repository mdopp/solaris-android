<?xml version="1.0" encoding="utf-8"?>
<!-- Device-picker row: type icon + name + room, Solaris-styled. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="16dp"
        android:tint="@color/solaris_accent"
        android:src="@drawable/ic_device"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/solaris_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/row_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/solaris_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Shown only on the row this widget is currently bound to (#96). -->
    <ImageView
        android:id="@+id/row_current"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:tint="@color/solaris_accent"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        android:contentDescription="@null" />
</LinearLayout>
