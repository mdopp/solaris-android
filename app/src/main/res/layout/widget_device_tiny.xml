<?xml version="1.0" encoding="utf-8"?>
<!-- Tiny device widget (1×1, #31 → #55 → #57): keep the NAME (top, single line,
     ellipsized — the user wants it) and make the TOGGLE a tappable state-tinted
     domain ICON with NO button chrome (#57). Tap the icon = the domain's primary
     action (toggle / open-close); tap the name = open the PWA. The state
     (position / brightness) is docked as a full-width bar at the bottom edge.
     RemoteViews-safe (LinearLayout / ImageView / TextView / ProgressBar — no
     plain <View>, no Button box). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">

    <!-- Name row: the device name (tap = open PWA) + a lock badge (#38) for
         sensitive devices needing a confirm. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/w_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#F2F2F5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/w_lock"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_lock"
            android:tint="#FFB0BEC5"
            android:visibility="gone"
            android:contentDescription="@string/widget_lock" />
    </LinearLayout>

    <!-- Toggle = a tappable, state-tinted domain icon (no button chrome, #57).
         Fills the middle; tap runs the domain's primary action. -->
    <ImageView
        android:id="@+id/w_tiny_toggle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:padding="6dp"
        android:src="@drawable/ic_light"
        android:tint="#FFFFC107"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- State bar: docked flush to the very bottom edge, full width. -->
    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="80"
        android:progressTint="#FFFFC107"
        android:progressBackgroundTint="#26FFFFFF" />
</LinearLayout>
