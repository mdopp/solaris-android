<?xml version="1.0" encoding="utf-8"?>
<!-- Tiny device widget (1×1, #31 revised by #55): the NAME wrapped/truncated
     ("Sofalich/t"), so at this tier we show the DOMAIN ICON (e.g. a lamp) instead
     of the name. A single primary toggle fills the middle (▲/▼ for covers, on/off
     glyph for lights/switches), and the state (position / brightness) is docked as
     a full-width bar flush to the bottom edge. RemoteViews-safe (LinearLayout /
     ImageView / TextView / Button / ProgressBar — no plain <View>). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">

    <!-- Icon row: domain icon (tap = open PWA) + a lock badge (#38) for sensitive
         devices needing a confirm. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:src="@drawable/ic_light"
            android:tint="#FFFFC107"
            android:scaleType="fitStart"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/w_lock"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_lock"
            android:tint="#FFB0BEC5"
            android:visibility="gone"
            android:contentDescription="@string/widget_lock" />
    </LinearLayout>

    <!-- Single primary toggle, weighted to fill the middle. -->
    <Button
        android:id="@+id/w_tiny_toggle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_btn_bg"
        android:text="○"
        android:textColor="#FFFFC107"
        android:textSize="22sp" />

    <!-- State bar: docked flush to the very bottom edge, full width. -->
    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="80"
        android:progressTint="#FFFFC107"
        android:progressBackgroundTint="#26FFFFFF" />
</LinearLayout>
