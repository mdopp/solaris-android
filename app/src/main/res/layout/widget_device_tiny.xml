<?xml version="1.0" encoding="utf-8"?>
<!-- Tiny device widget (1×1, #31): no icon — the NAME (2 lines) sits at the top,
     a single primary toggle fills the middle (▲/▼ for covers, on/off glyph for
     lights/switches), and the state (position / brightness) is docked as a
     full-width bar flush to the bottom edge. RemoteViews-safe (LinearLayout +
     weights only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">

    <!-- Name: 2 lines, tap = open PWA. -->
    <TextView
        android:id="@+id/w_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Wohnzimmer"
        android:textColor="#FFF2F2F5"
        android:textStyle="bold"
        android:textSize="13sp" />

    <!-- Single primary toggle, weighted to fill the middle. -->
    <Button
        android:id="@+id/w_tiny_toggle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_btn_bg"
        android:text="○"
        android:textColor="#FFFFC107"
        android:textSize="22sp" />

    <!-- State bar: docked flush to the very bottom edge, full width. -->
    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="80"
        android:progressTint="#FFFFC107"
        android:progressBackgroundTint="#26FFFFFF" />
</LinearLayout>
