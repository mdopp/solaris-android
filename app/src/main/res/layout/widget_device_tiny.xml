<?xml version="1.0" encoding="utf-8"?>
<!-- Tiny device widget (1×1, #31 → #55 → #57): keep the NAME (top, single line,
     ellipsized — the user wants it) and make the TOGGLE a tappable state-tinted
     domain ICON with NO button chrome (#57). Tap the icon = the domain's primary
     action (toggle / open-close); tap the name = open the PWA — except while the
     widget is unconfigured, when the WHOLE tile opens the picker (#94/#104).
     RemoteViews-safe (LinearLayout / ImageView / TextView / ProgressBar — no
     plain <View>, no Button box). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">

    <!-- Everything lives in ONE child container that fills the tile (#104). The
         launcher hosts `w_root` — the RemoteViews *root* — inside a container of
         its own and does not reliably deliver a click set on it, which is why the
         empty tile looked right and did nothing. `w_tiny_body` is an ordinary
         child, so a click set here arrives; and because it fills the tile edge to
         edge (no padding, no margins of its own), the setup tap has no dead
         corners and no dead gaps between the rows below. -->
    <LinearLayout
        android:id="@+id/w_tiny_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The device name, full width (tap = open PWA). The confirm badge (#38) is
             deliberately absent on this tier (#95): at 1×1 it ate about a third of the
             name width, and since #92 every tap on the tile opens the chooser anyway,
             so it announced something a touch makes obvious a moment later. The larger
             tiers keep their badge. -->
        <TextView
            android:id="@+id/w_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:text="—"
            android:textColor="#F2F2F5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Toggle = a tappable, state-tinted domain icon (no button chrome, #57).
             Fills the middle; tap runs the domain's primary action. -->
        <ImageView
            android:id="@+id/w_tiny_toggle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:padding="6dp"
            android:src="@drawable/ic_light"
            android:tint="#FFFFC107"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- State bar: docked flush to the very bottom edge, full width. -->
        <ProgressBar
            android:id="@+id/w_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="80"
            android:progressTint="#FFFFC107"
            android:progressBackgroundTint="#26FFFFFF" />
    </LinearLayout>
</LinearLayout>
