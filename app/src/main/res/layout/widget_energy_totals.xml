<?xml version="1.0" encoding="utf-8"?>
<!-- Energy "Gesamt": a 2x2 kWh totals grid (PV-Erzeugung / Einspeisung /
     Netzbezug / Batterie geladen) from /napi/portal/energy (totals). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_bolt"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/totals_title"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/t_cell0"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/t_l0" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="PV" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/t_v0" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FF66BB6A"
                android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/t_cell1"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/t_l1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="Einspeisung" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/t_v1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FF66BB6A"
                android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/t_cell2"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/t_l2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="Netzbezug" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/t_v2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FFEF5350"
                android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/t_cell3"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="4dp"
            android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/widget_btn_bg" android:padding="10dp">
            <TextView android:id="@+id/t_l3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="Batterie" android:textColor="#FFB0BEC5" android:textSize="12sp" />
            <TextView android:id="@+id/t_v3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1"
                android:ellipsize="end" android:text="—" android:textColor="#FF7E9CFF"
                android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
