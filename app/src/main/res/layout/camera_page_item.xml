<?xml version="1.0" encoding="utf-8"?>
<!-- One page in the camera capture gallery (#62): thumbnail + delete + reorder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="@dimen/space_sm">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="144dp">

        <ImageView
            android:id="@+id/page_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/field_solaris"
            android:scaleType="centerCrop"
            android:contentDescription="@string/camera_capture_title" />

        <TextView
            android:id="@+id/page_delete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/tile_accent_circle"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/solaris_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/page_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="4dp"
            android:background="#99000000"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="1"
            android:textColor="@color/solaris_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Reorder row: ◀ move left · ▶ move right. -->
    <LinearLayout
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/page_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="◀"
            android:textColor="@color/solaris_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/page_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="▶"
            android:textColor="@color/solaris_text_muted"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
