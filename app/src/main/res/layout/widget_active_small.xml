<?xml version="1.0" encoding="utf-8"?>
<!-- Small/compact active-devices overview (#28): a header count + a bounded row of
     per-type chips (icon + "N an/offen"), e.g. "💡 3 an · 🪟 2 offen". No single
     grand total on its own — the chips are the grouped-by-type summary. Up to 5
     chip slots + a "+N" overflow, all RemoteViews-safe (LinearLayout/ImageView/
     TextView only — no plain <View>). Tap → PWA. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/av_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/av_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_device"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/av_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="3 an"
            android:textColor="#FF66BB6A"
            android:textStyle="bold"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/av_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FF9AA0AE"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- Grouped-by-type chips. Each slot = icon + "N verb"; shown/hidden per group. -->
    <LinearLayout
        android:id="@+id/av_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/av_chip0_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/av_chip0_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="9dp"
            android:maxLines="1"
            android:textColor="#FFE0E6EA"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/av_chip1_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/av_chip1_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="9dp"
            android:maxLines="1"
            android:textColor="#FFE0E6EA"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/av_chip2_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/av_chip2_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="9dp"
            android:maxLines="1"
            android:textColor="#FFE0E6EA"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/av_chip3_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/av_chip3_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="9dp"
            android:maxLines="1"
            android:textColor="#FFE0E6EA"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/av_chip4_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/av_chip4_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="9dp"
            android:maxLines="1"
            android:textColor="#FFE0E6EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/av_chip_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFB0BEC5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
