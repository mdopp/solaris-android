<?xml version="1.0" encoding="utf-8"?>
<!-- Large active-devices overview (#28): header (count + refresh) + a real
     scrollable ListView collection. A ListView IS RemoteViews-collection-capable
     (backed by ActiveDevicesRemoteViewsService), so it shows EVERY active device
     and scrolls — replacing the old fixed row slots that could only show a few.
     Empty state via setEmptyView. RemoteViews-safe views only (no plain <View>).
     Tap a row → PWA (via the collection PendingIntentTemplate + per-row fill-in). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/av_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header: icon + count + refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/av_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_device"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/av_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="3 an"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/av_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="3dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FF9AA0AE"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- Empty view: shown by setEmptyView when the collection has no items. -->
    <TextView
        android:id="@+id/av_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/active_none"
        android:textColor="#FFB0BEC5"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- The scrollable collection: one row per active device, from the cached list. -->
    <ListView
        android:id="@+id/av_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
</LinearLayout>
