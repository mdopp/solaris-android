<?xml version="1.0" encoding="utf-8"?>
<!-- Wide/flat device widget (e.g. 4×1): NAME full-width at the very top (not
     ellipsized), a middle row with icon + state on the left and the inline control
     row on the right, and the level bar docked flush to the very bottom edge,
     spanning full width (#23). A discreet refresh icon sits top-right (#26).
     RemoteViews-safe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">

    <!-- Header (tap = open PWA): everything except the control buttons + refresh.
         Padded; the bottom bar sits outside this so it can go edge-to-edge. -->
    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Name row: full name at the very top + refresh top-right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/w_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="Wohnzimmer"
                android:textColor="#FFF2F2F5"
                android:textStyle="bold"
                android:textSize="16sp" />

            <!-- Lock badge (#38): shown for sensitive devices needing a confirm. -->
            <ImageView
                android:id="@+id/w_lock"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_lock"
                android:tint="#FFB0BEC5"
                android:visibility="gone"
                android:contentDescription="@string/widget_lock" />

            <ImageView
                android:id="@+id/w_refresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:padding="3dp"
                android:src="@drawable/ic_refresh"
                android:tint="#FF9AA0AE"
                android:contentDescription="@string/widget_refresh" />
        </LinearLayout>

        <!-- Middle row: icon + state on the left, controls on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_light"
                android:tint="#FFFFC107"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="an · 80 %"
                android:textColor="#FFFFC107"
                android:textStyle="bold"
                android:textSize="15sp" />

            <!-- Light controls: brightness − / + — weighted so the buttons always
                 fit the row width and never clip (#55). The colour swatch (#87)
                 is a third, GONE-by-default button, so a plain white bulb keeps the
                 exact geometry it had; minWidth=0 lets the weights alone decide the
                 split once three buttons share the row. -->
            <LinearLayout
                android:id="@+id/w_light_controls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <Button
                    android:id="@+id/w_light_color"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="●"
                    android:textColor="#FFFFC107"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/w_bright_down"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="−"
                    android:textColor="#FFF2F2F5"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/w_bright_up"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="+"
                    android:textColor="#FFF2F2F5"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Cover controls: up / stop / down — weighted so all three buttons
                 always fit the row width and never clip (#55). -->
            <LinearLayout
                android:id="@+id/w_cover_controls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <Button
                    android:id="@+id/w_cover_up"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="▲"
                    android:textColor="#FF7E9CFF"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/w_cover_stop"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="■"
                    android:textColor="#FFF2F2F5"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/w_cover_down"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_bg"
                    android:text="▼"
                    android:textColor="#FF7E9CFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Lock controls (#84): abschließen / aufschließen, both named. No
                 lock.open button anywhere — that unlatches the door. -->
            <LinearLayout
                android:id="@+id/w_lock_controls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <Button
                    android:id="@+id/w_lock_lock"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="@string/widget_lock_lock"
                    android:textColor="#FFF2F2F5"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/w_lock_unlock"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="@string/widget_lock_unlock"
                    android:textColor="#FFF2F2F5"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Switch control: single toggle — weighted so it fills the row and
                 never clips at narrow widths (#55). -->
            <LinearLayout
                android:id="@+id/w_switch_controls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <Button
                    android:id="@+id/w_switch_toggle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/widget_btn_bg"
                    android:text="Umschalten"
                    android:textColor="#FFF2F2F5"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Level bar: docked flush to the very bottom edge, full width, no margins. -->
    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:max="100"
        android:progress="80"
        android:progressTint="#FFFFC107"
        android:progressBackgroundTint="#26FFFFFF" />
</LinearLayout>
