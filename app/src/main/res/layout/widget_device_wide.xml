<?xml version="1.0" encoding="utf-8"?>
<!-- Wide/flat device widget (e.g. 4×1): name + state on the left, an inline
     control row on the right. Used when the widget is wide enough for controls
     but too short for the medium (stacked) layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:padding="12dp">

    <!-- Header (tap = on/off): icon + name + state, stacked -->
    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_light"
            android:tint="#FFFFC107"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Wohnzimmer"
                android:textColor="#FFF2F2F5"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/w_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="an · 80 %"
                android:textColor="#FFFFC107"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/w_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="80"
                android:progressTint="#FFFFC107"
                android:progressBackgroundTint="#26FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Light controls: brightness − / + -->
    <LinearLayout
        android:id="@+id/w_light_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <Button
            android:id="@+id/w_bright_down"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:text="−"
            android:textColor="#FFF2F2F5"
            android:textSize="20sp" />

        <Button
            android:id="@+id/w_bright_up"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn_bg"
            android:text="+"
            android:textColor="#FFF2F2F5"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Cover controls: up / stop / down -->
    <LinearLayout
        android:id="@+id/w_cover_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <Button
            android:id="@+id/w_cover_up"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:text="▲"
            android:textColor="#FF7E9CFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/w_cover_stop"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:text="■"
            android:textColor="#FFF2F2F5"
            android:textSize="16sp" />

        <Button
            android:id="@+id/w_cover_down"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn_bg"
            android:text="▼"
            android:textColor="#FF7E9CFF"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
