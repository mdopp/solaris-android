<?xml version="1.0" encoding="utf-8"?>
<!-- One pending-approval row (#43): title + service + description. Tap opens the
     PWA to act. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/space_sm"
    android:background="@drawable/card_solaris"
    android:padding="@dimen/space_md">

    <TextView
        android:id="@+id/ap_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/solaris_text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ap_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text=""
        android:textColor="@color/solaris_accent"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Full description, no truncation: an approval must be readable in full (#43). -->
    <TextView
        android:id="@+id/ap_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/solaris_text_muted"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/approvals_open_to_act"
        android:textColor="@color/solaris_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
