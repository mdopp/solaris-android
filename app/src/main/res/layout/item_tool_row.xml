<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the generic tool widget (#70). The slots mirror the closed
     tool-cell-schema role vocabulary (ADR 0011) one-to-one: title = primary line,
     subtitle + meta = the muted detail line, badge = the trailing status chip.
     A role the schema doesn't use is hidden by the factory — the layout carries no
     tool-specific knowledge. RemoteViews-safe views only.

     There is exactly ONE tap target here, the row root (#90). An action button
     used to sit at the end of the row and three attempts failed to make it take
     the press: first attributes (clickable, a 48dp target), then structure (no
     fill-in on the root at all, text column and button as siblings with one
     fill-in each). The app disproves the last one itself — ToolActionActivity
     opens the PWA only when no action id arrived, so "Solaris opened" means the
     button's fill-in never came. This launcher delivers one click target per
     collection row, whatever the docs allow, so the check mark is REMOVED rather
     than hidden and the choice moved into the sheet the row tap opens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:baselineAligned="false">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tw_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFF2F2F5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tw_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFB0BEC5"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tw_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="#FFB0BEC5"
        android:textStyle="bold"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
