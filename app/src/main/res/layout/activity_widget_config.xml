<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/solaris_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/config_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:textColor="@color/solaris_text"
        android:textStyle="bold"
        android:textSize="17sp" />

    <Button
        android:id="@+id/config_pair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/pairing_action"
        android:visibility="gone" />

    <ListView
        android:id="@+id/config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/solaris_divider"
        android:dividerHeight="1dp"
        android:scrollbarStyle="outsideOverlay" />
</LinearLayout>
