<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/solaris_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/config_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:textColor="@color/solaris_text"
        android:textStyle="bold"
        android:textSize="17sp" />

    <Button
        android:id="@+id/config_pair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/pairing_action"
        android:visibility="gone" />

    <EditText
        android:id="@+id/config_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/field_solaris"
        android:hint="@string/widget_config_search_hint"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:textColor="@color/solaris_text"
        android:textColorHint="@color/solaris_text_muted"
        android:drawablePadding="8dp"
        android:visibility="gone"
        android:importantForAutofill="no" />

    <ListView
        android:id="@+id/config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/solaris_divider"
        android:dividerHeight="1dp"
        android:scrollbarStyle="outsideOverlay" />
</LinearLayout>
