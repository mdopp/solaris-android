<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solaris_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Brand header: the "Solaris" wordmark with the figure as the "i"
             (Solar[figure]s) — no separate leading icon, mirroring the Solaris
             chat app. Extra top breathing room (#21). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solar"
                android:textColor="@color/solaris_text"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="33dp"
                android:adjustViewBounds="true"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_solaris_figure"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="s"
                android:textColor="@color/solaris_text"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="28dp"
            android:text="@string/home_claim"
            android:textColor="@color/solaris_text_muted"
            android:textSize="15sp" />

        <!-- Not connected: connect to your own server -->
        <LinearLayout
            android:id="@+id/connect_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_solaris"
            android:padding="20dp">

            <TextView
                android:id="@+id/connect_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/home_connect_hint"
                android:textColor="@color/solaris_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/qr_scan_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_scan" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/home_or_manual"
                android:textColor="@color/solaris_text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://dein-server"
                android:inputType="textUri"
                android:autofillHints="url"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/connect_btn"
                style="@style/Widget.Solaris.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_connect" />
        </LinearLayout>

        <!-- Connected: status + actions -->
        <LinearLayout
            android:id="@+id/connected_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_solaris"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_status_label"
                    android:textColor="@color/solaris_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/energy_supply"
                    android:textStyle="bold"
                    android:textSize="17sp" />
            </LinearLayout>

            <Button
                android:id="@+id/add_widget_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_add_widget" />

            <!-- Step 2 (#11): install the PWA for chat & notifications. Guidance,
                 not a blocker — a discreet card + ghost button, skippable AND
                 dismissible (the app can't detect an installed WebAPK, so a manual
                 "Ausblenden" persists a flag and hides the card for good). -->
            <LinearLayout
                android:id="@+id/install_pwa_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_solaris"
                android:padding="18dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_install_pwa_title"
                        android:textColor="@color/solaris_text"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/install_pwa_dismiss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="✕"
                        android:textColor="@color/solaris_text_muted"
                        android:textSize="18sp"
                        android:contentDescription="@string/home_install_pwa_dismiss" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_install_pwa_hint"
                    android:textColor="@color/solaris_text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/install_pwa_btn"
                    style="@style/Widget.Solaris.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/home_install_pwa" />
            </LinearLayout>

            <Button
                android:id="@+id/open_btn"
                style="@style/Widget.Solaris.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_open" />

            <Button
                android:id="@+id/logout_btn"
                style="@style/Widget.Solaris.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/home_logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
