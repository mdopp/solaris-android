<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solaris_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <!-- ── Brand block — the first-run moment (#37), shown while UNPAIRED ──
             The "Solar[figure]s" wordmark floating in a soft blue glow is what an
             empty app has to say for itself. Once the install is paired it is
             pure decoration in front of the content the user came for (#126), so
             the Activity hides the whole block and the status line becomes the
             screen's header. -->
        <LinearLayout
            android:id="@+id/brand_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <ImageView
                    android:layout_width="@dimen/hero_glow_size"
                    android:layout_height="@dimen/hero_glow_size"
                    android:layout_gravity="center"
                    android:translationY="0dp"
                    android:src="@drawable/hero_glow"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center">

                    <TextView
                        style="@style/Text.Solaris.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solar" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="39dp"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="2dp"
                        android:src="@drawable/ic_solaris_figure"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/Text.Solaris.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="s" />
                </LinearLayout>
            </FrameLayout>

            <!-- Accent underline: a short ServiceBay-blue rule, centred under the
                 wordmark, tying the lockup to the brand colour. -->
            <View
                android:layout_width="52dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:background="@color/solaris_accent" />

            <TextView
                style="@style/Text.Solaris.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_xl"
                android:text="@string/home_claim" />
        </LinearLayout>

        <!-- ── Not connected: connect to your own server ─────────────────── -->
        <LinearLayout
            android:id="@+id/connect_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_solaris"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/connect_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/home_connect_hint"
                android:textColor="@color/solaris_text"
                android:textSize="@dimen/text_body"
                android:lineSpacingExtra="3sp" />

            <Button
                android:id="@+id/qr_scan_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_scan" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/home_or_manual"
                android:textColor="@color/solaris_text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://dein-server"
                android:inputType="textUri"
                android:autofillHints="url"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/connect_btn"
                style="@style/Widget.Solaris.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/home_connect" />

            <!-- Request access (#50): a discreet link-style affordance for users
                 without an account yet — opens the server's request-access page
                 in a Custom Tab (pre-auth public web flow, ADR 0010). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/home_request_access_intro"
                android:textColor="@color/solaris_text_muted"
                android:textSize="13sp"
                android:gravity="center_horizontal" />

            <TextView
                android:id="@+id/request_access_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/home_request_access"
                android:textColor="@color/solaris_accent"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- ── Connected: the hub behind the surface ──────────────────────────
             Order is priority, top down (#126/#127): where you are, the way into
             Solaris, then the things the hub actually owns — Live-Updates and
             widgets. Everything below the widget card is optional and may fall
             below the fold. -->
        <LinearLayout
            android:id="@+id/connected_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 1. Status line: full width like every card and button around it
                 (#126) — a wrap_content pill sat visibly short of the right edge.
                 Dot + host; tinted green when connected (wired in the Activity). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_solaris"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/status"
                    style="@style/Text.Solaris.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>

            <!-- 2. The way into Solaris (#127). Since #115 the surface opens *in*
                 this app, so this is a view switch, not a jump out — and it is the
                 product's main surface, not a side feature next to Live-Updates.
                 Therefore: the filled primary, directly under the status line, and
                 no longer a ghost button sharing a footer row with "Abmelden". -->
            <Button
                android:id="@+id/open_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/home_open" />

            <!-- 3. Live-Updates (#48): opt-in realtime SSE. One short line says
                 what it does; the why (persistent notification, battery, idle
                 interval) sits behind the info icon (#126). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:background="@drawable/card_solaris"
                android:padding="@dimen/card_padding"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/space_sm">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Text.Solaris.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_realtime_title" />

                        <ImageView
                            android:id="@+id/realtime_info"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="9dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/solaris_text_muted"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/home_realtime_info_cd" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_realtime_hint"
                        android:textColor="@color/solaris_text_muted"
                        android:textSize="13sp" />

                    <!-- Screen-off backstop poll interval — a live setting, so it
                         stays on the card (only while Live-Updates is on, #48);
                         what it means is explained in the info dialog. -->
                    <TextView
                        android:id="@+id/realtime_interval"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/realtime_interval_off"
                        android:textColor="@color/solaris_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <Switch
                    android:id="@+id/realtime_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 4. "Widget hinzufügen": tapping a tile pins that widget type (the
                 energy tile opens a Jetzt/Verlauf/Gesamt chooser). The five
                 household types are what almost every user wants; ServiceBay and
                 the catalog-driven tools sit behind "Weitere Widgets" (#126) —
                 hidden, never removed. -->
            <LinearLayout
                android:id="@+id/widgets_teaser_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_solaris"
                android:padding="@dimen/card_padding"
                android:layout_marginTop="@dimen/space_md">

                <TextView
                    style="@style/Text.Solaris.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_widgets_teaser_title"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_widgets_teaser_hint"
                    android:textColor="@color/solaris_text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="@dimen/space_sm" />

                <!-- 5-column grid of equal-weight tappable tiles. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:id="@+id/tile_device"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minHeight="@dimen/tile_min_height"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:background="@drawable/tile_solaris"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/home_tile_device">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:src="@drawable/ic_device"
                            app:tint="@color/solaris_accent"
                            android:contentDescription="@null" />

                        <TextView
                            style="@style/Text.Solaris.Tile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_tile_device" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_energy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minHeight="@dimen/tile_min_height"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:background="@drawable/tile_solaris"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/home_tile_energy">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/solaris_accent"
                            android:contentDescription="@null" />

                        <TextView
                            style="@style/Text.Solaris.Tile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_tile_energy" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_active"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minHeight="@dimen/tile_min_height"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:background="@drawable/tile_solaris"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/home_tile_active">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:src="@drawable/ic_switch"
                            app:tint="@color/solaris_accent"
                            android:contentDescription="@null" />

                        <TextView
                            style="@style/Text.Solaris.Tile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_tile_active" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_camera"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minHeight="@dimen/tile_min_height"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:background="@drawable/tile_solaris"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/home_tile_camera">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/solaris_accent"
                            android:contentDescription="@null" />

                        <TextView
                            style="@style/Text.Solaris.Tile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_tile_camera" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_voice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minHeight="@dimen/tile_min_height"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:background="@drawable/tile_solaris"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/home_tile_voice">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/solaris_accent"
                            android:contentDescription="@null" />

                        <TextView
                            style="@style/Text.Solaris.Tile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_tile_voice" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Behind "Weitere Widgets" (#126): the infra widgets (#42/#44)
                     and the catalog-driven tool widgets (#72). Collapsed by
                     default so the first screen shows five tiles instead of a
                     dozen — every entry stays one tap away. -->
                <LinearLayout
                    android:id="@+id/more_widgets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Text.Solaris.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_widgets_group_servicebay"
                        android:layout_marginTop="@dimen/space_md"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:id="@+id/tile_sb_overview"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/space_xs"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:minHeight="@dimen/tile_min_height"
                            android:paddingTop="@dimen/space_sm"
                            android:paddingBottom="@dimen/space_sm"
                            android:background="@drawable/tile_solaris"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/home_tile_sb_overview">

                            <ImageView
                                android:layout_width="@dimen/tile_icon"
                                android:layout_height="@dimen/tile_icon"
                                android:src="@drawable/ic_servicebay"
                                app:tint="@color/solaris_accent"
                                android:contentDescription="@null" />

                            <TextView
                                style="@style/Text.Solaris.Tile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/home_tile_sb_overview" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tile_sb_services"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:minHeight="@dimen/tile_min_height"
                            android:paddingTop="@dimen/space_sm"
                            android:paddingBottom="@dimen/space_sm"
                            android:background="@drawable/tile_solaris"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/home_tile_sb_services">

                            <ImageView
                                android:layout_width="@dimen/tile_icon"
                                android:layout_height="@dimen/tile_icon"
                                android:src="@drawable/ic_services"
                                app:tint="@color/solaris_accent"
                                android:contentDescription="@null" />

                            <TextView
                                style="@style/Text.Solaris.Tile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/home_tile_sb_services" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tools group (#72): NOT a static tile list — filled at
                         runtime from the server's .tool catalog (/napi/defs/tool),
                         so a newly installed plugin shows up as an addable widget
                         without an app rebuild. Hidden until the catalog yields a
                         listable tool. -->
                    <TextView
                        android:id="@+id/tools_group_title"
                        style="@style/Text.Solaris.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_widgets_group_tools"
                        android:layout_marginTop="@dimen/space_md"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tools_group_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_tools_hint"
                        android:textColor="@color/solaris_text_muted"
                        android:textSize="13sp"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/tools_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/more_widgets_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"
                    android:gravity="center"
                    android:text="@string/home_more_widgets"
                    android:textColor="@color/solaris_accent"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <!-- 5. Install-PWA card (#11): dismissible; below the fold on purpose
                 — the app itself is the surface since #115, this is only about the
                 browser's Web Push. IDs preserved. -->
            <LinearLayout
                android:id="@+id/install_pwa_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_solaris"
                android:padding="@dimen/card_padding"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_install_pwa_title"
                        android:textColor="@color/solaris_text"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:id="@+id/install_pwa_dismiss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="✕"
                        android:textColor="@color/solaris_text_muted"
                        android:textSize="18sp"
                        android:contentDescription="@string/home_install_pwa_dismiss" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_install_pwa_hint"
                    android:textColor="@color/solaris_text_muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2sp" />

                <Button
                    android:id="@+id/install_pwa_btn"
                    style="@style/Widget.Solaris.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/home_install_pwa" />
            </LinearLayout>

            <!-- 6. Sign out — rare, and the opposite of what the screen is for, so
                 it steps back to a quiet link beside the version line (#126). -->
            <TextView
                android:id="@+id/logout_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/home_logout"
                android:textColor="@color/solaris_text_muted"
                android:textSize="@dimen/text_body"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Installed app version — and the way into the diagnostics screen
             (#110), which is what makes the notification path checkable. -->
        <TextView
            android:id="@+id/app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/app_version_placeholder"
            android:textColor="@color/solaris_text_faint"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</ScrollView>
