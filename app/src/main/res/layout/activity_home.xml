<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solaris_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- ── Hero ────────────────────────────────────────────────────────
             The "Solar[figure]s" wordmark with the figure as the "i", plus the
             claim underneath. Generous top breathing room so the brand can
             breathe (#37 design pass, keeps the wordmark + accent). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solar"
                android:textColor="@color/solaris_text"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="37dp"
                android:adjustViewBounds="true"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_solaris_figure"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="s"
                android:textColor="@color/solaris_text"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />
        </LinearLayout>

        <!-- Accent underline: a short ServiceBay-blue rule tying the wordmark to
             the brand colour. -->
        <View
            android:layout_width="52dp"
            android:layout_height="3dp"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="14dp"
            android:background="@color/solaris_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="32dp"
            android:text="@string/home_claim"
            android:textColor="@color/solaris_text_muted"
            android:textSize="16sp"
            android:letterSpacing="0.01" />

        <!-- ── Not connected: connect to your own server ─────────────────── -->
        <LinearLayout
            android:id="@+id/connect_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_solaris"
            android:padding="22dp">

            <TextView
                android:id="@+id/connect_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/home_connect_hint"
                android:textColor="@color/solaris_text"
                android:textSize="16sp"
                android:lineSpacingExtra="3sp" />

            <Button
                android:id="@+id/qr_scan_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_scan" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/home_or_manual"
                android:textColor="@color/solaris_text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://dein-server"
                android:inputType="textUri"
                android:autofillHints="url"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/connect_btn"
                style="@style/Widget.Solaris.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_connect" />
        </LinearLayout>

        <!-- ── Connected: status + actions ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/connected_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Status card: label + a colored status dot (Ampel) alongside the
                 server host, in a refined card. The dot is tinted green when
                 connected, muted otherwise (wired in the Activity). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_solaris"
                android:padding="22dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_status_label"
                    android:textColor="@color/solaris_text_muted"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/status_dot" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@color/solaris_text"
                        android:textStyle="bold"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Primary action: add a widget. Filled accent → the clear CTA. -->
            <Button
                android:id="@+id/add_widget_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_add_widget" />

            <!-- "Deine Widgets" teaser (#37): a discreet card hinting at what's
                 available, so the primary CTA has context. -->
            <LinearLayout
                android:id="@+id/widgets_teaser_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_solaris"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_widgets_teaser_title"
                    android:textColor="@color/solaris_text"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_widgets_teaser_hint"
                    android:textColor="@color/solaris_text_muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3sp"
                    android:layout_marginBottom="16dp" />

                <!-- Type chips: icon-only pills teasing the widget catalogue. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:padding="11dp"
                        android:background="@drawable/chip_solaris"
                        android:src="@drawable/ic_device"
                        app:tint="@color/solaris_accent"
                        android:contentDescription="@string/widget_type_device" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:padding="11dp"
                        android:background="@drawable/chip_solaris"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/solaris_accent"
                        android:contentDescription="@string/widget_type_energy_now" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:padding="11dp"
                        android:background="@drawable/chip_solaris"
                        android:src="@drawable/ic_switch"
                        app:tint="@color/solaris_accent"
                        android:contentDescription="@string/widget_type_active" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:padding="11dp"
                        android:background="@drawable/chip_solaris"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/solaris_accent"
                        android:contentDescription="@string/widget_type_camera" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:padding="11dp"
                        android:background="@drawable/chip_solaris"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/solaris_accent"
                        android:contentDescription="@string/widget_type_voice" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 2 (#11): install the PWA for chat & notifications. Guidance,
                 not a blocker — a discreet card + ghost button, skippable AND
                 dismissible (the app can't detect an installed WebAPK, so a manual
                 "Ausblenden" persists a flag and hides the card for good). -->
            <LinearLayout
                android:id="@+id/install_pwa_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_solaris"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_install_pwa_title"
                        android:textColor="@color/solaris_text"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/install_pwa_dismiss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="✕"
                        android:textColor="@color/solaris_text_muted"
                        android:textSize="18sp"
                        android:contentDescription="@string/home_install_pwa_dismiss" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_install_pwa_hint"
                    android:textColor="@color/solaris_text_muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3sp" />

                <Button
                    android:id="@+id/install_pwa_btn"
                    style="@style/Widget.Solaris.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_install_pwa" />
            </LinearLayout>

            <!-- Secondary actions, visually subordinate to the primary CTA. -->
            <Button
                android:id="@+id/open_btn"
                style="@style/Widget.Solaris.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/home_open" />

            <Button
                android:id="@+id/logout_btn"
                style="@style/Widget.Solaris.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
