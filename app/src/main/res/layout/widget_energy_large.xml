<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/e_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_bolt"
            android:tint="#FF66BB6A"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/e_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Energie"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/e_pv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="PV   2,1 kW"
        android:textColor="#FF66BB6A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/e_house"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Haus   1,3 kW"
        android:textColor="#FFB0BEC5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/e_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Netz   0,8 kW · Einspeisung"
        android:textColor="#FF66BB6A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/e_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Akku   0,3 kW · lädt"
        android:textColor="#FFEF5350"
        android:textSize="14sp" />
</LinearLayout>
