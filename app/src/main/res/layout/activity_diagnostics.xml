<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostics (#48): version + last crash + connection log, copyable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/solaris_bg"
    android:padding="@dimen/screen_gutter">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/diag_title"
        style="@style/Text.Solaris.Headline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/diag_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/solaris_text_muted"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:text="—" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="@dimen/space_md">

        <Button
            android:id="@+id/diag_copy"
            style="@style/Widget.Solaris.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/diag_copy" />

        <Button
            android:id="@+id/diag_clear"
            style="@style/Widget.Solaris.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diag_clear" />
    </LinearLayout>
</LinearLayout>
