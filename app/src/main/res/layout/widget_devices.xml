<?xml version="1.0" encoding="utf-8"?>
<!-- Devices trigger tile (#167): the unified trigger-tile pattern (#54), the same
     shape as the voice and camera tiles — a filled accent circle with a glyph and
     one bold word. A tap opens the household start page, where every pinned device
     shows its live state and can be operated.
     RemoteViews-safe (LinearLayout / ImageView / TextView only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devices_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/devices_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/tile_accent_circle"
        android:padding="12dp"
        android:src="@drawable/ic_device"
        android:tint="#FFFFFFFF"
        android:contentDescription="@string/devices_widget_label" />

    <TextView
        android:id="@+id/devices_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/devices_widget_cta"
        android:textColor="@color/solaris_text"
        android:textStyle="bold"
        android:textSize="13sp" />
</LinearLayout>
