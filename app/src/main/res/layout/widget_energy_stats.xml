<?xml version="1.0" encoding="utf-8"?>
<!-- Energy "Verlauf": a multi-line PV/Haus/Netz/Akku history chart with a
     legend and a 24h ⇄ 7d toggle (per-instance, fired via PendingIntent since
     RemoteViews has no interactive toggle). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/es_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Title + range toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/es_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/stats_title"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/es_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:padding="3dp"
            android:src="@drawable/ic_refresh"
            android:tint="#FFB0BEC5"
            android:contentDescription="@string/widget_refresh" />

        <TextView
            android:id="@+id/es_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="24h"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/es_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Legend: colored dots per leg (text carries the • glyph, colored). -->
    <LinearLayout
        android:id="@+id/es_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/es_lg0" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="10dp"
            android:text="● PV" android:textColor="#FF66BB6A" android:textSize="11sp" />
        <TextView android:id="@+id/es_lg1" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="10dp"
            android:text="● Haus" android:textColor="#FFEF5350" android:textSize="11sp" />
        <TextView android:id="@+id/es_lg2" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="10dp"
            android:text="● Netz" android:textColor="#FFFFC107" android:textSize="11sp" />
        <TextView android:id="@+id/es_lg3" android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Akku" android:textColor="#FF7E9CFF" android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/es_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/stats_title"
        android:textColor="#FFB0BEC5"
        android:textSize="12sp" />
</LinearLayout>
