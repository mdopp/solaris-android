<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 tool launcher tile (#71): the unified trigger-tile pattern (#54) — an
     accent circle with a glyph plus one bold word. No data is fetched and no
     schema is rendered; a tap is a deep link into the PWA (compose = the tool's
     declared tool-compose-path, chat = #/?tool=<id>). Which glyph/word appears is
     decided by the bound mode, not by the tool.
     RemoteViews-safe (LinearLayout / ImageView / TextView only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/tl_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/tile_accent_circle"
        android:padding="12dp"
        android:src="@drawable/ic_plus"
        android:tint="#FFFFFFFF"
        android:contentDescription="@string/tool_launch_label" />

    <TextView
        android:id="@+id/tl_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/tool_launch_label"
        android:textColor="@color/solaris_text"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tl_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/tool_launch_cta_compose"
        android:textColor="#FFB0BEC5"
        android:textSize="11sp" />
</LinearLayout>
