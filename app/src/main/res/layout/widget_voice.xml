<?xml version="1.0" encoding="utf-8"?>
<!-- Voice/mic trigger tile (#17): unified trigger-tile pattern (#54) — a filled
     Solaris-accent circle (52dp) with a white mic glyph + a single bold "Sprechen"
     label. Structurally identical to the camera tile (widget_camera.xml); only the
     glyph + word differ. Tapping the body fires a PendingIntent into
     VoiceTrampolineActivity, which captures speech and opens the ?ask= chat.
     RemoteViews-safe (LinearLayout / ImageView / TextView only — no plain <View>). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/voice_mic"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/tile_accent_circle"
        android:padding="12dp"
        android:src="@drawable/ic_mic"
        android:tint="#FFFFFFFF"
        android:contentDescription="@string/voice_widget_label" />

    <TextView
        android:id="@+id/voice_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/voice_widget_cta"
        android:textColor="@color/solaris_text"
        android:textStyle="bold"
        android:textSize="13sp" />
</LinearLayout>
