<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cloud.dopp.solaris">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Realtime SSE foreground service (#48): live-updates opt-in. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 caps the dataSync FGS type at ~6h/24h → use specialUse (no cap)
         for the long-lived realtime push connection; dataSync kept for API 29–33. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Screen-off backstop poll (#48): hold CPU briefly for the network check. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Voice/mic widget (#17): device speech-to-text capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: see browsers / Custom Tabs providers. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Voice widget (#17): see the system speech recognizer on Android 11+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".SolarisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.Solaris">

        <!-- Launcher + onboarding hub. Also captures the pairing deep link
             cloud.dopp.solaris://pair#token=… from the server's /pair-device page. -->
        <activity
            android:name=".ui.OnboardingHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/appName">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cloud.dopp.solaris" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Universal device widget (#4). -->
        <!-- What Solaris told this household (#158) — the destination a
             notification tap never had. -->
        <activity
            android:name=".ui.NoticesActivity"
            android:exported="false"
            android:label="@string/notices_title" />

        <receiver
            android:name=".widget.DeviceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_device_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!-- House energy widget (#8). -->
        <receiver
            android:name=".widget.EnergyWidgetProvider"
            android:exported="true"
            android:label="@string/energy_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_widget_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_device_label"
            android:theme="@style/Theme.Solaris.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Headless tap handler for the device widget (no visible screen). -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- successCallback of requestPinAppWidget (#105): the only place the app
             learns the appWidgetId the host just assigned, so this is where a
             pinned tool widget gets bound. Not exported — it fires only through
             our own PendingIntent, which runs with our identity. -->
        <receiver
            android:name=".widget.WidgetPinReceiver"
            android:exported="false" />

        <!-- taskAffinity="" (#114): without an affinity of its own this dialog
             started INSIDE the app's task, and being translucent it showed
             whatever screen was on top of it — the homescreen when no task
             existed, the last open screen otherwise. Its own task also keeps a
             second action from landing on the first one's. excludeFromRecents
             stays, so the throwaway task never shows up in Recents. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The Solaris surface inside the app (#115): hosts the Trusted Web
             Activity that shows the paired server full-screen, without a URL bar
             and on Chrome's existing Authelia session. Default task affinity, so
             it lives in the app's own task and shows up in Recents as Solaris;
             singleTop so a second tap re-navigates the open surface.

             DELIBERATELY not exported and carrying NO intent-filter for
             https://chat.dopp.cloud: an exported (let alone autoVerify'd) filter
             would make the app a system-wide handler for that address, and any
             app on the phone could push a URL into the signed-in household view.
             The surface is opened by the app itself — the hub's "Zu Solaris",
             widgets, shortcuts, notifications — and by nothing else. Since #129
             the launcher entry is OnboardingHomeActivity again. -->
        <activity
            android:name=".ui.SolarisSurfaceActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/appName"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Solaris" />

        <!-- Invisible trampoline: a widget body tap opens the PWA in a Custom Tab (#27). -->
        <activity
            android:name=".widget.PwaTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Energy statistics widget (#9): 48h house-consumption sparkline. -->
        <receiver
            android:name=".widget.EnergyStatsWidgetProvider"
            android:exported="true"
            android:label="@string/stats_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_stats_widget_info" />
        </receiver>

        <!-- Active-devices overview widget (#28): which devices are on/open. -->
        <receiver
            android:name=".widget.ActiveDevicesWidgetProvider"
            android:exported="true"
            android:label="@string/active_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/active_devices_widget_info" />
        </receiver>

        <!-- Collection service backing the scrollable active-devices ListView (#28). -->
        <service
            android:name=".widget.ActiveDevicesRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Camera snapshot widget (#30): a bound camera's current frame. -->
        <receiver
            android:name=".widget.CameraWidgetProvider"
            android:exported="true"
            android:label="@string/camera_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/camera_widget_info" />
        </receiver>

        <!-- Native camera capture + upload screen (#36): opened by the camera
             trigger widget; takes photos, optionally builds a PDF, uploads to /napi. -->
        <activity
            android:name=".ui.CameraCaptureActivity"
            android:exported="false"
            android:label="@string/camera_capture_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Solaris" />

        <activity
            android:name=".widget.CameraWidgetConfigActivity"
            android:exported="true"
            android:label="@string/camera_widget_label"
            android:theme="@style/Theme.Solaris.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Voice/mic widget (#17): tap → speech → auto-sent household chat. -->
        <receiver
            android:name=".widget.VoiceWidgetProvider"
            android:exported="true"
            android:label="@string/voice_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/voice_widget_info" />
        </receiver>

        <!-- Invisible speech-capture trampoline for the voice widget (#17). -->
        <activity
            android:name=".widget.VoiceTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Energy totals widget (#16): 2x2 kWh totals grid (Gesamt). -->
        <receiver
            android:name=".widget.EnergyTotalsWidgetProvider"
            android:exported="true"
            android:label="@string/totals_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_totals_widget_info" />
        </receiver>

        <!-- Diagnostics (#48): version + last crash + connection log. -->
        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diag_title"
            android:theme="@style/Theme.Solaris" />

        <!-- In-app pending-approvals list (#43): read-only feed; rows open the PWA to act. -->
        <activity
            android:name=".ui.ApprovalsActivity"
            android:exported="false"
            android:label="@string/approvals_title"
            android:theme="@style/Theme.Solaris" />

        <!-- ServiceBay overview widget (#42): home-summary from /napi/servicebay/home. -->
        <receiver
            android:name=".widget.SbOverviewWidgetProvider"
            android:exported="true"
            android:label="@string/sb_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sb_overview_widget_info" />
        </receiver>

        <!-- ServiceBay service-status summary widget (#44): healthy/warning/failure. -->
        <receiver
            android:name=".widget.SbServicesWidgetProvider"
            android:exported="true"
            android:label="@string/sb_services_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sb_services_widget_info" />
        </receiver>

        <!-- Generic schema-driven .tool widget (#70): ONE provider that renders any
             tool from the catalog's tool-cell-schema — a new .tool plugin becomes a
             widget with no native code (#72 lists them in the in-app picker). -->
        <receiver
            android:name=".widget.ToolWidgetProvider"
            android:exported="true"
            android:label="@string/tool_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tool_widget_info" />
        </receiver>

        <!-- Collection service backing the tool widget's scrollable row list (#70). -->
        <service
            android:name=".widget.ToolRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Binds a placed tool widget to one tool-id from the live catalog (#70). -->
        <activity
            android:name=".widget.ToolWidgetConfigActivity"
            android:exported="true"
            android:label="@string/tool_widget_label"
            android:theme="@style/Theme.Solaris.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Row target of the tool widget (#70/#90): a collection has ONE pending-
             intent template, so this one activity handles both fill-ins — the body
             tap (open the PWA) and the action button (POST /napi/action-callback,
             with the server's confirm gate). Invisible; no layout is set. -->
        <activity
            android:name=".widget.ToolActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 1x1 tool launcher tile (#71): a deep link into the PWA for one tool —
             its declared create path, or the chat with its card already open. -->
        <receiver
            android:name=".widget.ToolLauncherWidgetProvider"
            android:exported="true"
            android:label="@string/tool_launch_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tool_launcher_widget_info" />
        </receiver>

        <!-- Binds a placed launcher tile to one tool-id + mode from the catalog (#71). -->
        <activity
            android:name=".widget.ToolLauncherConfigActivity"
            android:exported="true"
            android:label="@string/tool_launch_label"
            android:theme="@style/Theme.Solaris.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Realtime SSE client (#48): embedded foreground service that wakes
             device widgets from card_state pushes. Opt-in, off by default. -->
        <service
            android:name=".realtime.RealtimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Long-lived push/SSE connection to the user's own Solaris server for live widget + approval updates." />
        </service>

        <!-- Screen-off backstop poll alarm target (#48). -->
        <receiver
            android:name=".realtime.RealtimeIdleReceiver"
            android:exported="false" />

        <!-- Restart the realtime service after a reboot (only if opted-in). -->
        <receiver
            android:name=".realtime.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Share captured photos with the system camera app for ACTION_IMAGE_CAPTURE
             (#36). Authority mirrors the fileprovider used by FileProvider.getUriForFile. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>
</manifest>
