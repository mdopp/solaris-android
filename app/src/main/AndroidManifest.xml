<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cloud.dopp.solaris">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Realtime SSE foreground service (#48): live-updates opt-in. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Screen-off backstop poll (#48): hold CPU briefly for the network check. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Voice/mic widget (#17): device speech-to-text capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: see browsers / Custom Tabs providers. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Voice widget (#17): see the system speech recognizer on Android 11+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".SolarisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.Solaris">

        <!-- Launcher + onboarding hub. Also captures the pairing deep link
             cloud.dopp.solaris://pair#token=… from the server's /pair-device page. -->
        <activity
            android:name=".ui.OnboardingHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/appName">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cloud.dopp.solaris" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Universal device widget (#4). -->
        <receiver
            android:name=".widget.DeviceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_device_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!-- House energy widget (#8). -->
        <receiver
            android:name=".widget.EnergyWidgetProvider"
            android:exported="true"
            android:label="@string/energy_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_widget_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_device_label"
            android:theme="@style/Theme.Solaris.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Headless tap handler for the device widget (no visible screen). -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <activity
            android:name=".widget.WidgetActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Invisible trampoline: a widget body tap opens the PWA in a Custom Tab (#27). -->
        <activity
            android:name=".widget.PwaTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Energy statistics widget (#9): 48h house-consumption sparkline. -->
        <receiver
            android:name=".widget.EnergyStatsWidgetProvider"
            android:exported="true"
            android:label="@string/stats_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_stats_widget_info" />
        </receiver>

        <!-- Active-devices overview widget (#28): which devices are on/open. -->
        <receiver
            android:name=".widget.ActiveDevicesWidgetProvider"
            android:exported="true"
            android:label="@string/active_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/active_devices_widget_info" />
        </receiver>

        <!-- Collection service backing the scrollable active-devices ListView (#28). -->
        <service
            android:name=".widget.ActiveDevicesRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Camera snapshot widget (#30): a bound camera's current frame. -->
        <receiver
            android:name=".widget.CameraWidgetProvider"
            android:exported="true"
            android:label="@string/camera_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/camera_widget_info" />
        </receiver>

        <!-- Native camera capture + upload screen (#36): opened by the camera
             trigger widget; takes photos, optionally builds a PDF, uploads to /napi. -->
        <activity
            android:name=".ui.CameraCaptureActivity"
            android:exported="false"
            android:label="@string/camera_capture_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Solaris" />

        <activity
            android:name=".widget.CameraWidgetConfigActivity"
            android:exported="true"
            android:label="@string/camera_widget_label"
            android:theme="@style/Theme.Solaris.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Voice/mic widget (#17): tap → speech → auto-sent household chat. -->
        <receiver
            android:name=".widget.VoiceWidgetProvider"
            android:exported="true"
            android:label="@string/voice_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/voice_widget_info" />
        </receiver>

        <!-- Invisible speech-capture trampoline for the voice widget (#17). -->
        <activity
            android:name=".widget.VoiceTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Energy totals widget (#16): 2x2 kWh totals grid (Gesamt). -->
        <receiver
            android:name=".widget.EnergyTotalsWidgetProvider"
            android:exported="true"
            android:label="@string/totals_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_totals_widget_info" />
        </receiver>

        <!-- Diagnostics (#48): version + last crash + connection log. -->
        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diag_title"
            android:theme="@style/Theme.Solaris" />

        <!-- In-app pending-approvals list (#43): read-only feed; rows open the PWA to act. -->
        <activity
            android:name=".ui.ApprovalsActivity"
            android:exported="false"
            android:label="@string/approvals_title"
            android:theme="@style/Theme.Solaris" />

        <!-- ServiceBay overview widget (#42): home-summary from /napi/servicebay/home. -->
        <receiver
            android:name=".widget.SbOverviewWidgetProvider"
            android:exported="true"
            android:label="@string/sb_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sb_overview_widget_info" />
        </receiver>

        <!-- ServiceBay service-status summary widget (#44): healthy/warning/failure. -->
        <receiver
            android:name=".widget.SbServicesWidgetProvider"
            android:exported="true"
            android:label="@string/sb_services_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sb_services_widget_info" />
        </receiver>

        <!-- Realtime SSE client (#48): embedded foreground service that wakes
             device widgets from card_state pushes. Opt-in, off by default. -->
        <service
            android:name=".realtime.RealtimeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Screen-off backstop poll alarm target (#48). -->
        <receiver
            android:name=".realtime.RealtimeIdleReceiver"
            android:exported="false" />

        <!-- Restart the realtime service after a reboot (only if opted-in). -->
        <receiver
            android:name=".realtime.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Share captured photos with the system camera app for ACTION_IMAGE_CAPTURE
             (#36). Authority mirrors the fileprovider used by FileProvider.getUriForFile. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>
</manifest>
